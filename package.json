{
  "name": "m3u8-player",
  "version": "1.0.6",
  "description": "M3U8 播放器桌面版",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir"
  },
  "author": "finder0519-mac",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.7"
  },
  "build": {
    "appId": "com.m3u8.player",
    "productName": "M3U8 播放器",
    "artifactName": "m3u8-player-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "files": [
      "out/main/**",
      "out/preload/**",
      "m3u8-player.html",
      "js/**/*.js"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "需要访问本地网络以连接你配置的局域网代理服务器。"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon_rounded.png"
    }
  },
  "allowScripts": {
    "electron@45.3.0": true
  }
}
