{
  "name": "m3u8-player",
  "version": "1.0.5",
  "description": "M3U8 播放器桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "author": "finder0519-mac",
  "license": "MIT",
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.m3u8.player",
    "productName": "M3U8 播放器",
    "artifactName": "m3u8-player-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "m3u8-player.html",
      "js/**/*.js"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "需要访问本地网络以连接你配置的局域网代理服务器。"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon_rounded.png"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
